@implements IDisposable
@inject StartupApiClient Api
@inject AuthSession Session
@inject IdeasState Ideas
@inject NavigationManager Nav

<aside class="sidebar">
    <a class="brand" href="analyze">
        <img class="brand-mark" src="images/logo.jpg" alt="Startup Validator" />
        <span class="brand-name">Startup Validator</span>
    </a>

    <a class="new-idea" href="analyze">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
        Нова ідея
    </a>
    <a class="new-idea mobile-only" href="ideas">Історія</a>

    <div class="sidebar-label">Історія</div>

    <nav class="history">
        @if (ideas is null)
        {
            <div class="history-empty">Завантаження…</div>
        }
        else if (ideas.Count == 0)
        {
            <div class="history-empty">Ще немає ідей</div>
        }
        else
        {
            @foreach (var idea in ideas)
            {
                <NavLink class="history-item" href="@($"ideas/{idea.Id}")" Match="NavLinkMatch.All" title="@idea.IdeaText">
                    @idea.IdeaText
                </NavLink>
            }
        }
    </nav>

    <a class="history-all" href="ideas">Усі ідеї</a>

    <div class="sidebar-footer">
        <span class="avatar">@Initial</span>
        <span class="user-email">@Session.Email</span>
        <button class="link-button" @onclick="LogoutAsync">Вийти</button>
    </div>
</aside>

@code {
    private List<IdeaSummary>? ideas;

    private string Initial => string.IsNullOrEmpty(Session.Email) ? "?" : Session.Email[..1].ToUpper();

    protected override async Task OnInitializedAsync()
    {
        Ideas.Changed += OnIdeasChanged;
        await LoadAsync();
    }

    // Список ідей для бічної панелі
    private async Task LoadAsync()
    {
        if (!Session.IsLoggedIn) return;

        var result = await Api.GetIdeasAsync(Session.Token!);
        ideas = result.Ok && result.Data is not null ? result.Data : new List<IdeaSummary>();
    }

    private void OnIdeasChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("/login");
    }

    public void Dispose() => Ideas.Changed -= OnIdeasChanged;
}