@implements IDisposable
@inject AuthSession Session

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Startup Validator</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="analyze">Аналіз ідеї</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ideas">Історія</NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">Вхід</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register">Реєстрація</NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
