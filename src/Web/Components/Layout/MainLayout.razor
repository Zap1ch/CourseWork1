@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession Session

@if (!Session.IsLoaded)
{
    <div class="loading-screen">Завантаження…</div>
}
else if (Session.IsLoggedIn)
{
    <div class="app">
        <NavMenu />
        <main class="main">
            @Body
        </main>
    </div>
}
else
{
    <div class="auth-page">
        @Body
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Сталася помилка.
    <a href="." class="reload">Перезавантажити</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    // Сховище браузера доступне лише після першого рендеру
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Session.LoadAsync();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}