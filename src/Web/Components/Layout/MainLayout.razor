@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession Session
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Session.IsLoggedIn)
            {
                <span class="me-3">@Session.Email</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Вийти</button>
            }
        </div>

        <article class="content px-4">
            @if (Session.IsLoaded)
            {
                @Body
            }
            else
            {
                <p><em>Завантаження…</em></p>
            }
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Сталася помилка.
    <a href="." class="reload">Перезавантажити</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    // Сховище браузера доступне лише після першого рендеру
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Session.LoadAsync();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("/login");
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
