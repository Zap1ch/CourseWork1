<div class="nabc">
    @foreach (var part in Parts)
    {
        <section class="nabc-section">
            <h3><span class="nabc-letter @part.Css">@part.Letter</span>@part.Title</h3>
            <p>@(string.IsNullOrWhiteSpace(part.Text) ? "—" : part.Text)</p>
        </section>
    }
</div>

@code {
    [Parameter] public string? Need { get; set; }
    [Parameter] public string? Approach { get; set; }
    [Parameter] public string? Benefit { get; set; }
    [Parameter] public string? Competition { get; set; }

    // Чотири розділи в порядку N, A, B, C
    private (string Letter, string Title, string Css, string? Text)[] Parts =>
    [
        ("N", "Need — потреба", "nabc-n", Need),
        ("A", "Approach — підхід", "nabc-a", Approach),
        ("B", "Benefit — вигоди на витрати", "nabc-b", Benefit),
        ("C", "Competition — конкуренція", "nabc-c", Competition)
    ];
}