@page "/register"
@inject StartupApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Реєстрація · Startup Validator</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark">SV</span>
        <h1 class="auth-title">Створити акаунт</h1>
        <p class="auth-sub">AI-аналіз ідей стартапів за методикою NABC</p>
    </div>

    <EditForm Model="model" OnValidSubmit="RegisterAsync" FormName="register">
        <DataAnnotationsValidator />

        <div class="field">
            <label>Email</label>
            <InputText class="input" @bind-Value="model.Email" autocomplete="email" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="field">
            <label>Пароль</label>
            <InputText type="password" class="input" @bind-Value="model.Password" autocomplete="new-password" />
            <ValidationMessage For="() => model.Password" />
        </div>

        <div class="field">
            <label>Повторіть пароль</label>
            <InputText type="password" class="input" @bind-Value="model.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => model.ConfirmPassword" />
        </div>

        @if (error is not null)
        {
            <div class="alert-error">@error</div>
        }

        <button type="submit" class="button button-primary" disabled="@isLoading">
            @(isLoading ? "Реєстрація..." : "Зареєструватися")
        </button>
    </EditForm>

    <p class="auth-switch">Вже є акаунт? <a href="login">Увійти</a></p>
</div>

@code {
    private readonly RegisterModel model = new();
    private string? error;
    private bool isLoading;

    private async Task RegisterAsync()
    {
        error = null;
        isLoading = true;

        var email = model.Email.Trim();
        var registered = await Api.RegisterAsync(email, model.Password);

        if (!registered.Ok)
        {
            isLoading = false;
            error = registered.Error ?? "Не вдалося зареєструватися.";
            return;
        }

        // Одразу входимо новим акаунтом
        var login = await Api.LoginAsync(email, model.Password);
        isLoading = false;

        if (login.Ok && login.Data?.Token is not null)
        {
            await Session.SignInAsync(login.Data.Token, email);
            Nav.NavigateTo("/analyze");
        }
        else
        {
            Nav.NavigateTo("/login");
        }
    }
}