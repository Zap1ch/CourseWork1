@page "/analyze"
@inject StartupApiClient Api
@inject AuthSession Session
@inject IdeasState Ideas
@inject NavigationManager Nav

<PageTitle>Нова ідея · Startup Validator</PageTitle>

@if (pendingText is null)
{
    <div class="container empty-state">
        <h1 class="greeting">Яку ідею перевіримо?</h1>
        <p class="greeting-sub">Опишіть, для кого продукт, яку проблему він вирішує і як заробляє.</p>

        <EditForm Model="model" OnValidSubmit="AnalyzeAsync" FormName="analyze">
            <DataAnnotationsValidator />

            <div class="composer">
                <InputTextArea @bind-Value="model.IdeaText" placeholder="Наприклад: мобільний застосунок, який допомагає студентам…" />
                <button type="submit" class="send-button" title="Аналізувати">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
                </button>
            </div>
            <ValidationMessage For="() => model.IdeaText" />
        </EditForm>

        @if (error is not null)
        {
            <div class="alert-error">@error</div>
        }

        <p class="composer-hint">AI оцінює ідею за методикою NABC: потреба, підхід, вигоди, конкуренція.</p>
    </div>
}
else
{
    <div class="container">
        <div class="message-user">
            <div class="bubble">@pendingText</div>
        </div>

        <div class="message-ai">
            <span class="brand-mark ai-mark">SV</span>
            <div class="ai-body">
                <div class="ai-title">Аналізую ідею…</div>
                <div class="typing"><span></span><span></span><span></span></div>
            </div>
        </div>
    </div>
}

@code {
    private readonly IdeaModel model = new();
    private string? pendingText;
    private string? error;

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn)
            Nav.NavigateTo("/login");
    }

    private async Task AnalyzeAsync()
    {
        error = null;
        pendingText = model.IdeaText.Trim();

        var response = await Api.AnalyzeAsync(Session.Token!, pendingText);

        if (response.Ok && response.Data is not null)
        {
            // Оновити історію і відкрити збережений аналіз
            Ideas.NotifyChanged();
            Nav.NavigateTo($"/ideas/{response.Data.Id}");
        }
        else if (response.Unauthorized)
        {
            await Session.SignOutAsync();
            Nav.NavigateTo("/login");
        }
        else
        {
            pendingText = null;
            error = response.Error;
        }
    }
}