@page "/ideas"
@inject StartupApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Усі ідеї · Startup Validator</PageTitle>

<div class="container">
    <h1 class="page-title">Усі ідеї</h1>

    @if (error is not null)
    {
        <div class="alert-error">@error</div>
    }
    else if (ideas is null)
    {
        <p class="muted">Завантаження…</p>
    }
    else if (ideas.Count == 0)
    {
        <p class="muted">Ідей ще немає. <a href="analyze">Проаналізувати першу</a></p>
    }
    else
    {
        <div class="idea-list">
            @foreach (var idea in ideas)
            {
                <a class="idea-row" href="@($"ideas/{idea.Id}")">
                    <span class="idea-date">@idea.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    <span class="idea-text">@idea.IdeaText</span>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<IdeaSummary>? ideas;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var result = await Api.GetIdeasAsync(Session.Token!);

        if (result.Ok)
        {
            ideas = result.Data;
        }
        else if (result.Unauthorized)
        {
            await Session.SignOutAsync();
            Nav.NavigateTo("/login");
        }
        else
        {
            error = result.Error;
        }
    }
}