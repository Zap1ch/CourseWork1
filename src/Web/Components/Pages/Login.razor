@page "/login"
@inject StartupApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Вхід</PageTitle>

<h1>Вхід</h1>

<div style="max-width: 420px">
    <EditForm Model="model" OnValidSubmit="LoginAsync" FormName="login">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="model.Email" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <InputText type="password" class="form-control" @bind-Value="model.Password" />
            <ValidationMessage For="() => model.Password" />
        </div>

        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@isLoading">
            @(isLoading ? "Вхід..." : "Увійти")
        </button>
    </EditForm>

    <p class="mt-3">Немає акаунта? <a href="/register">Зареєструватися</a></p>
</div>

@code {
    private readonly LoginModel model = new();
    private string? error;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (Session.IsLoggedIn)
            Nav.NavigateTo("/analyze");
    }

    private async Task LoginAsync()
    {
        error = null;
        isLoading = true;

        var email = model.Email.Trim();
        var result = await Api.LoginAsync(email, model.Password);

        isLoading = false;

        if (result.Ok && result.Data?.Token is not null)
        {
            await Session.SignInAsync(result.Data.Token, email);
            Nav.NavigateTo("/analyze");
        }
        else
        {
            error = result.Error ?? result.Data?.Message ?? "Не вдалося увійти.";
        }
    }
}
