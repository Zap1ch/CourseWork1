@page "/login"
@inject StartupApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Вхід · Startup Validator</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark">SV</span>
        <h1 class="auth-title">З поверненням</h1>
        <p class="auth-sub">Увійдіть, щоб перевіряти ідеї стартапів</p>
    </div>

    <EditForm Model="model" OnValidSubmit="LoginAsync" FormName="login">
        <DataAnnotationsValidator />

        <div class="field">
            <label>Email</label>
            <InputText class="input" @bind-Value="model.Email" autocomplete="email" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="field">
            <label>Пароль</label>
            <InputText type="password" class="input" @bind-Value="model.Password" autocomplete="current-password" />
            <ValidationMessage For="() => model.Password" />
        </div>

        @if (error is not null)
        {
            <div class="alert-error">@error</div>
        }

        <button type="submit" class="button button-primary" disabled="@isLoading">
            @(isLoading ? "Вхід..." : "Увійти")
        </button>
    </EditForm>

    <p class="auth-switch">Немає акаунта? <a href="register">Зареєструватися</a></p>
</div>

@code {
    private readonly LoginModel model = new();
    private string? error;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (Session.IsLoggedIn)
            Nav.NavigateTo("/analyze");
    }

    private async Task LoginAsync()
    {
        error = null;
        isLoading = true;

        var email = model.Email.Trim();
        var result = await Api.LoginAsync(email, model.Password);

        isLoading = false;

        if (result.Ok && result.Data?.Token is not null)
        {
            await Session.SignInAsync(result.Data.Token, email);
            Nav.NavigateTo("/analyze");
        }
        else
        {
            error = result.Error ?? result.Data?.Message ?? "Не вдалося увійти.";
        }
    }
}