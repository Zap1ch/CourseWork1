@page "/ideas/{Id:int}"
@inject StartupApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Ідея · Startup Validator</PageTitle>

<div class="container">
    @if (error is not null)
    {
        <div class="alert-error">@error</div>
        <div class="chat-footer"><a class="button" href="analyze">Нова ідея</a></div>
    }
    else if (idea is null)
    {
        <p class="muted">Завантаження…</p>
    }
    else
    {
        <div class="meta">@idea.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</div>

        <div class="message-user">
            <div class="bubble">@idea.IdeaText</div>
        </div>

        <div class="message-ai">
            <img class="brand-mark ai-mark" src="images/logo.jpg" alt="" />
            <div class="ai-body">
                <div class="ai-title">Аналіз за методикою NABC</div>
                <NabcView Need="@idea.Need" Approach="@idea.Approach" Benefit="@idea.Benefit" Competition="@idea.Competition" />
            </div>
        </div>

        <div class="chat-footer"><a class="button" href="analyze">+ Нова ідея</a></div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private IdeaDetails? idea;
    private string? error;

    // Викликається і при першому відкритті, і при зміні Id в адресі
    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        idea = null;
        error = null;

        var result = await Api.GetIdeaAsync(Session.Token!, Id);

        if (result.Ok)
        {
            idea = result.Data;
        }
        else if (result.Unauthorized)
        {
            await Session.SignOutAsync();
            Nav.NavigateTo("/login");
        }
        else
        {
            error = result.Error == "Not found" ? "Ідею не знайдено." : result.Error;
        }
    }
}